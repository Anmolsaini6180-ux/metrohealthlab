    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cloudinary": "^2.10.1",
    "firebase-admin": "^12.3.1",
    "firebase-functions": "^5.0.1",
    "razorpay": "^2.9.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
