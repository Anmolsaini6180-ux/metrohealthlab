# ============================================================
# PUBLIC FRONTEND VARIABLES
# ============================================================
# Everything below is compiled into the JS bundle and visible to anyone
# who opens devtools. Only put values here that are safe in public.
#
# In production these live in Vercel: Project → Settings → Environment
# Variables (Production + Preview). A local .env is only for `npm run dev`.

# Razorpay PUBLISHABLE key. NEVER the key secret.
# Required for the checkout modal to open.
VITE_RAZORPAY_KEY_ID=

# ---- Cloudinary (PUBLIC / BROWSER SAFE) ----
# Required for admin image upload (branding logo/favicon, banners).
# Both values are public by design: the cloud name identifies the
# account, and the preset names an UNSIGNED upload preset whose own
# server-side restrictions (allowed formats, max file size, target
# folder, delivery type) are what actually contain the upload.
#
# Create the preset at: Cloudinary console -> Settings -> Upload ->
# Upload presets -> Add upload preset, with Signing Mode = Unsigned.
# Recommended restrictions on the preset itself:
#   Folder:            metro-health
#   Allowed formats:   jpg, png, webp, gif, svg
#   Max file size:     5 MB
#   Delivery type:     upload
# See DEPLOYMENT.md -> "Cloudinary upload preset" for the full walkthrough.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# NEVER add CLOUDINARY_API_SECRET (or any VITE_ variant of it) here or
# anywhere in this repository. Signed uploads need it, and signed
# uploads therefore only ever run inside a Cloud Function.

# ---- Backend capability switch (PUBLIC) ----
# Leave unset while the project is on the Firebase Spark plan: features
# that genuinely need a server (booking list/mutations, customer
# directory, leads list, segments, team performance, sending
# notifications, report upload/download, payment orders) then show a
# truthful "requires backend service" state instead of failing.
#
# Set to true ONLY after upgrading to Blaze, adding a "functions" block
# to firebase.json and deploying /functions. No frontend code changes
# are needed — the services switch to their callable path on their own.
# VITE_FUNCTIONS_ENABLED=true

# ---- Supabase (PUBLIC / BROWSER SAFE) ----
# Foundation only — not yet used by LoginPage/useAuth. Both values are
# public by design: the URL identifies the project, and the
# publishable key's security boundary is Row Level Security, not
# secrecy. Get them from Supabase -> Project Settings -> API.
#
# NEVER add SUPABASE_SERVICE_ROLE_KEY (or any VITE_ variant of it)
# here or anywhere in this repository — it belongs only in
# scripts/migration/, read from a local file path outside the repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Optional Firebase overrides ----
# src/firebase/config.ts already contains the production Firebase Web
# config for metro-health-0001 as a hardcoded default, so a clean clone
# builds and runs with none of these set. Set them only to point a
# preview/staging deployment at a DIFFERENT Firebase project.
# (Firebase Web config is not a secret — the security boundary is
# Firestore Security Rules, not hiding these values.)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ============================================================
# NO SERVER-SIDE CONFIGURATION IS NEEDED
# ============================================================
#
# This project runs on the Firebase Spark (free) plan and deploys no
# Cloud Functions, so there is no functions/.env, no Secret Manager
# entry and no MASTER_ADMIN_EMAIL anywhere in the runtime.
#
# Who the super admin is, is NOT configured through an environment
# variable and never through a VITE_* one. It is a single Firestore
# document, system/config, holding the master account's Firebase Auth
# uid. Only the Firebase Console / Admin SDK can write it (see
# firestore.rules), which is exactly what makes it trustworthy: the
# browser reads it, it never decides it.
#
# Do NOT add a VITE_MASTER_ADMIN_EMAIL or any other role-related Vite
# variable. Anything compiled into the bundle is attacker-editable and
# can never be an authorization decision.
#
# See DEPLOYMENT.md -> "First super admin bootstrap" for the exact
# one-time console step.
