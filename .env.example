# ============================================================
# PUBLIC FRONTEND VARIABLES
# ============================================================
# Everything below is compiled into the JS bundle and visible to anyone
# who opens devtools. Only put values here that are safe in public.
#
# In production these live in Vercel: Project → Settings → Environment
# Variables (Production + Preview). A local .env is only for `npm run dev`.

# Razorpay PUBLISHABLE key. NEVER the key secret.
# Required for the checkout modal to open.
VITE_RAZORPAY_KEY_ID=

# ---- Optional Firebase overrides ----
# src/firebase/config.ts already contains the production Firebase Web
# config for metro-health-0001 as a hardcoded default, so a clean clone
# builds and runs with none of these set. Set them only to point a
# preview/staging deployment at a DIFFERENT Firebase project.
# (Firebase Web config is not a secret — the security boundary is
# Firestore/Storage rules plus custom claims, not hiding these values.)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# ============================================================
# SERVER-SIDE SECRETS — NEVER put these in this file or any .env
# ============================================================
#
# This project keeps zero server secrets in any .env file. Cloud
# Functions secrets live exclusively in Firebase Functions Secret
# Manager, set via the Firebase CLI (never committed, never present
# locally):
#
#   firebase functions:secrets:set RAZORPAY_KEY_ID
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
#   firebase functions:secrets:set CLOUDINARY_CLOUD_NAME
#   firebase functions:secrets:set CLOUDINARY_API_KEY
#   firebase functions:secrets:set CLOUDINARY_API_SECRET
#
# CLOUDINARY_CLOUD_NAME and CLOUDINARY_API_KEY are not strictly secret
# (Cloudinary itself sends them from the browser during a signed
# upload), but they're stored server-side anyway so that rotating the
# Cloudinary account never requires a frontend redeploy.
#
# See DEPLOYMENT.md for the full one-time setup.


# ============================================================
# MASTER_ADMIN_EMAIL — backend configuration, NOT a Vite variable
# ============================================================
#
# The email address that is granted SUPER_ADMIN on sign-in. It is
# deliberately NOT a secret (an email is an identity, not a credential
# — you still have to prove you own that Google account), so it needs
# no Secret Manager and no Blaze-only feature: it is an ordinary Cloud
# Functions deploy parameter with a committed default.
#
# Configure it in functions/.env — see functions/.env.example.
#
# Do NOT add a VITE_MASTER_ADMIN_EMAIL. The frontend must never make an
# authorization decision from an email; the role always comes from the
# custom claim that syncMyRole writes server-side.

