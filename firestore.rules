rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---------- Staff role model ----------
    // Authorization for staff is based entirely on Firebase Auth CUSTOM
    // CLAIMS (request.auth.token.role / .adminId / .subAdminId /
    // .superAdminId) — never on a Firestore document's existence or
    // content. Claims are set only by the createTeamMember Cloud
    // Function (Admin SDK), which itself only lets an existing
    // SUPER_ADMIN/ADMIN/SUB_ADMIN create the next role down — a client
    // can write anything it wants to Firestore and it will never change
    // its own token's claims, so self-granting or self-escalating a
    // role is not possible this way.
    function role() {
      return isSignedIn() && "role" in request.auth.token ? request.auth.token.role : null;
    }
    function isStaff() {
      return role() in ["SUPER_ADMIN", "ADMIN", "SUB_ADMIN", "COLLECTION_AGENT"];
    }
    function isSuperAdmin() {
      return role() == "SUPER_ADMIN";
    }
    // SUPER_ADMIN and ADMIN manage the catalog (tests, packages, labs,
    // pricing, offers, banners, coupons, slots, service areas, content).
    // SUB_ADMIN/COLLECTION_AGENT are operational roles and never get
    // catalog write access.
    function canManageCatalog() {
      return role() in ["SUPER_ADMIN", "ADMIN"];
    }
    // Every catalog write must self-report its author, and rules verify
    // that claim matches the actual signed-in caller — this is what the
    // auto-audit Firestore triggers (catalogAuditTriggers.ts) use to
    // attribute changes, since Firestore triggers don't otherwise carry
    // "who wrote this" information.
    function validAdminWrite() {
      return canManageCatalog() && request.resource.data.updatedBy == request.auth.uid;
    }

    // ---------- Public catalog data: readable by anyone, writable only
    // by SUPER_ADMIN/ADMIN (direct, rules-gated) or Cloud Functions
    // (Admin SDK bypasses rules) ----------
    match /tests/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /testCategories/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /packages/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /labs/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /labPricing/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /serviceAreas/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /pincodes/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /collectionCenters/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /slots/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /articles/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /articleCategories/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /faqs/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /testimonials/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /banners/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /offers/{id} { allow read: if true; allow write: if validAdminWrite(); }
    match /settings/{id} { allow read: if true; allow write: if validAdminWrite(); }

    // Coupons: customers never read this collection directly (preview
    // goes through getBookingQuote; redemption through createBooking —
    // both Admin SDK). Staff who can manage the catalog can read/write
    // it directly for the admin coupons screen.
    match /coupons/{id} {
      allow read: if canManageCatalog();
      allow write: if validAdminWrite();
    }
    match /couponUsage/{id} { allow read: if canManageCatalog(); allow write: if false; }

    // ---------- Marketing (admin-managed; Cloud Functions not yet
    // required since nothing here is money- or capacity-sensitive the
    // way bookings/payments are) ----------
    match /campaigns/{id} { allow read: if canManageCatalog(); allow write: if validAdminWrite(); }
    match /segments/{id} { allow read: if canManageCatalog(); allow write: if validAdminWrite(); }
    match /leads/{id} {
      allow get: if canManageCatalog() || (
        isStaff() && (
          (role() == "SUB_ADMIN" && resource.data.assignedSubAdminId == request.auth.uid) ||
          (role() == "COLLECTION_AGENT" && resource.data.assignedCollectionAgentId == request.auth.uid)
        )
      );
      // Hierarchy-scoped listing goes through the getLeads Cloud
      // Function, same reasoning as bookings/team above.
      allow list: if false;
      allow create: if validAdminWrite();
      // SUPER_ADMIN/ADMIN can edit anything; a SUB_ADMIN/COLLECTION_AGENT
      // assigned a lead can only change its status (matching the
      // customer-facing "update just these fields" pattern used
      // elsewhere), never reassign it to themselves or edit its details.
      allow update: if validAdminWrite() || (
        isStaff() && (
          (role() == "SUB_ADMIN" && resource.data.assignedSubAdminId == request.auth.uid) ||
          (role() == "COLLECTION_AGENT" && resource.data.assignedCollectionAgentId == request.auth.uid)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedBy', 'updatedAt']) &&
        request.resource.data.updatedBy == request.auth.uid
      );
      allow delete: if false;
    }

    // ---------- User-owned data ----------
    match /users/{userId} {
      // A caller can always read their own doc; staff can read a doc
      // that's inside their own hierarchy (SUPER_ADMIN: everyone;
      // ADMIN: anyone whose denormalized adminId is them; SUB_ADMIN:
      // anyone whose subAdminId is them).
      allow get: if isOwner(userId) || (
        isStaff() && (
          isSuperAdmin() ||
          (role() == "ADMIN" && resource.data.adminId == request.auth.uid) ||
          (role() == "SUB_ADMIN" && resource.data.subAdminId == request.auth.uid)
        )
      );
      // Team listings go through the getTeamMembers Cloud Function, not
      // a direct collection query — rules can't safely bound an
      // arbitrary `list` the way a trusted server-side .where() can.
      allow list: if false;
      // Self-signup only, and can never include a role — staff accounts
      // are created exclusively by createTeamMember (Admin SDK, which
      // bypasses rules entirely and is the only code path that ever
      // sets role/superAdminId/adminId/subAdminId).
      allow create: if isOwner(userId) && !("role" in request.resource.data);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'photoUrl', 'dateOfBirth', 'gender', 'preferences', 'updatedAt']);
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
    }

    match /addresses/{addressId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId;
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canManageCatalog());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Even admin-sent notifications go through sendAdminNotification
      // (Cloud Function, Admin SDK) rather than a direct write — that's
      // where the hierarchy scope check (can this admin message this
      // customer?) actually happens.
      allow create, delete: if false;
    }

    match /supportTickets/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Bookings: customers read only their own. Staff can `get` (not
    // `list`) an individual booking that's within their hierarchy scope
    // — SUPER_ADMIN sees any booking, ADMIN sees their assigned bookings
    // plus the unassigned "confirmed" pool they triage, SUB_ADMIN/
    // COLLECTION_AGENT see only bookings assigned into their own scope.
    // The admin Bookings table itself reads via the getAdminBookings
    // Cloud Function, not a direct `list` — this `get` rule is defense
    // in depth for anyone deep-linking a specific booking ID. All
    // writes go through Cloud Functions (createBooking, payment
    // webhooks, assignBooking, updateBookingStatus).
    match /bookings/{id} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (isStaff() && (
          isSuperAdmin() ||
          (role() == "ADMIN" && (resource.data.assignedAdminId == request.auth.uid || resource.data.bookingStatus == "confirmed")) ||
          (role() == "SUB_ADMIN" && resource.data.assignedSubAdminId == request.auth.uid) ||
          (role() == "COLLECTION_AGENT" && resource.data.assignedAgentId == request.auth.uid)
        ))
      );
      allow list: if false;
      allow write: if false;
    }

    match /bookingItems/{id} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.userId == request.auth.uid;
      allow write: if false;
    }

    match /bookingStatusHistory/{id} {
      allow read: if isSignedIn() &&
        get(/databases/$(database)/documents/bookings/$(resource.data.bookingId)).data.userId == request.auth.uid;
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canManageCatalog());
      allow write: if false;
    }

    match /refunds/{id} {
      allow read: if isSignedIn() && (
        get(/databases/$(database)/documents/payments/$(resource.data.paymentId)).data.userId == request.auth.uid ||
        canManageCatalog()
      );
      allow write: if false;
    }

    // Reports: customer metadata read only for their own; the actual
    // file only ever comes from getReportDownloadUrl (Admin SDK). Staff
    // with catalog-management rights can also read metadata to manage
    // the report lifecycle.
    //
    // ALL writes are Cloud-Function-only (confirmReportUpload /
    // setReportReady, Admin SDK). Direct admin writes used to be
    // allowed here, which meant a staff account could file a report
    // against an arbitrary userId, or point an existing report's
    // filePath at another customer's file — getReportDownloadUrl only
    // checks that the CALLER owns the report, so that was a real path
    // to leaking customer B's health data to customer A. The functions
    // now derive userId from the booking document and take every file
    // field from Cloudinary's own response, so neither is possible.
    match /reports/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canManageCatalog());
      allow write: if false;
    }

    // Media library index for the admin Upload Center. Rows are written
    // exclusively by confirmMediaUpload/deleteMediaAsset (Admin SDK)
    // from Cloudinary's own verified response — a client can neither
    // fabricate an entry nor edit one. Read is staff-only; the public
    // site never needs this collection, since the delivered image URL
    // is denormalized onto the banner/test/package/lab document itself.
    match /mediaAssets/{id} {
      allow read: if canManageCatalog();
      allow write: if false;
    }

    // Email-keyed staff role assignments. This is the collection that
    // decides who is an admin, so it is Cloud-Function-only in BOTH
    // directions: written exclusively by upsertStaffMember /
    // revokeStaffMember / createTeamMember (Admin SDK, which bypasses
    // rules), and never read directly by a client — the Admin & Staff
    // screen lists it through the getStaffDirectory callable, which
    // applies the caller's hierarchy scope in trusted code. A client
    // being able to write here would be a direct path to self-granting
    // a role at next sign-in, so nothing short of `false` is safe.
    match /staffInvites/{email} { allow read, write: if false; }

    // ---------- Internal / staff-only ----------
    match /roles/{id} { allow read: if isOwner(id) || isStaff(); allow write: if false; }
    match /permissions/{id} { allow read: if isStaff(); allow write: if false; }
    match /auditLogs/{id} { allow read: if isSuperAdmin(); allow write: if false; }
    match /collectors/{id} { allow read: if isStaff(); allow write: if false; }

    // Idempotency ledgers + server-side price quotes — pure internal
    // bookkeeping for the Cloud Functions. No client ever needs to
    // read or write these directly.
    match /bookingRequests/{id} { allow read, write: if false; }
    match /processedWebhookEvents/{id} { allow read, write: if false; }
    match /priceQuotes/{id} { allow read, write: if false; }
  }
}
