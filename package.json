{
  "name": "metro-health-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run sitemap && vite build",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project metro-health-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "verify": "npm run typecheck && npm run build && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "firebase": "^10.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "firebase-tools": "^13.35.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.4",
    "vitest": "^2.1.9",
    "ws": "^8.21.3"
  }
}
